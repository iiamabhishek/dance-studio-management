{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "cmd /c build-fix.bat",
    "installCommand": "composer install --no-dev --no-scripts --prefer-dist --optimize-autoloader",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ],
    "crons": [
        {
            "path": "/v/cron",
            "schedule": "0 0 * * *"
        }
    ]
}
